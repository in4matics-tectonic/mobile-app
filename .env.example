# Copy to .env.local (git-ignored) and restart `npx expo start`.

# --- Dev proxy (Metro, Node only: never bundled into the app) ---
# Backend that /v1 is forwarded to during development. Default: the shared PoC VM.
# Use http://127.0.0.1:3000 to run ../backend locally (`pnpm dev`, no password gate).
KBC_API_TARGET=https://api.34-23-164-33.sslip.io
# Kate chat that /kate-chat, /api and /vendor are forwarded to (embedded when you tap the Kate orb).
# Default: chat.<domain> next to KBC_API_TARGET, or http://127.0.0.1:7003 for a local poc-runner.
# KATE_CHAT_TARGET=https://chat.34-23-164-33.sslip.io
# Shared site password of the PoC VM (the gate in front of api.<domain> and chat.<domain>).
KBC_GATE_PASSWORD=

# --- App (inlined into the bundle) ---
# Demo customer to log in as: tom or lien (they share customer K-2024-0417).
# EXPO_PUBLIC_KBC_USER=tom
# Run without the backend, on the built-in mock signals.
# EXPO_PUBLIC_SIGNALS_SOURCE=mock
# Kate chat, opened from the Kate orb (WebView on iOS/Android, iframe on web).
# Default: https://chat.34-23-164-33.sslip.io/?app=kate, except on the web dev server, which loads the
# same chat through the dev proxy (/kate-chat/?app=kate) so KBC_GATE_PASSWORD passes the site password.
# EXPO_PUBLIC_KATE_CHAT_URL=https://chat.34-23-164-33.sslip.io/?app=kate
